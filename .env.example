# Modèle des variables d'environnement du site.
#
# En production : à définir dans Vercel → Settings → Environment Variables
# (jamais dans un fichier commité — ce dépôt est public).
# En local : copier ce fichier en `.env.local`, remplir les valeurs ;
# `.env*` est ignoré par Git, seul ce modèle vide est versionné.
#
# Toute variable définie ici prime sur la valeur saisie dans le tableau
# de bord administrateur.

# --- Administration ---
ADMIN_PASSWORD=

# --- Base de données (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (carte bancaire, Apple Pay) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=

# --- SingPay (Airtel Money / Moov Money) ---
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_WALLET=
SINGPAY_DISBURSEMENT=
SINGPAY_WEBHOOK_TOKEN=

# --- E-mail de confirmation d'achat ---
# Option 1 : envoi depuis une adresse Gmail (mot de passe d'application
# Google : myaccount.google.com/apppasswords, exige la validation en 2 étapes).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option 2 : Resend (domaine vérifié requis). Ignoré si Gmail est configuré.
RESEND_API_KEY=
RESEND_FROM_EMAIL=